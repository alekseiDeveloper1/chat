{
  "name": "chat",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web",
